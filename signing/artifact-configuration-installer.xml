<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer": the Inno Setup installer,
  built from the already signed executables and uploaded as one GitHub
  Actions artifact (a zip holding the single .exe). Its version resource
  is set by installer/steptrim.iss from the same version.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="StepTrim-Setup-*.exe" product-name="StepTrim" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
